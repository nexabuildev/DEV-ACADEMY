// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 1. USUARIOS: Con soporte para Auth.js y Roles
model User {
  id            String         @id @default(cuid())
  name          String?
  email         String         @unique
  emailVerified DateTime?
  password      String?
  role          Role           @default(STUDENT)
  enrollments   Enrollment[]   
  userProgress  UserProgress[]
  posts         Post[]
  comments      Comment[]
  votes         Vote[]
  notifications Notification[]
  achievements  Achievement[]
  notes         Note[]
  savedPosts    SavedPost[]
  savedLessons  SavedLesson[]
  
  // Auth.js
  accounts      Account[]
  sessions      Session[]

  // Datos de Perfil
  bio           String?   @db.Text
  githubUrl     String?
  websiteUrl    String?
  image         String?
  location      String?
  emoji         String?        @default("👨‍💻")
  xp            Int            @default(0)


  createdAt     DateTime       @default(now())
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}



enum Role {
  STUDENT
  ADMIN
}

// 2. CURSOS: El contenedor principal
model Course {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  description String
  category    Category     @default(WEB)
  published   Boolean      @default(false)
  enrollments Enrollment[]
  lessons     Lesson[]
  posts       Post[]
  createdAt   DateTime     @default(now())
}


enum Category {
  WEB
  DATABASE
  PROGRAMMING
}


// 3. LECCIONES: Las unidades que llenan la barra de progreso
model Lesson {
  id           String         @id @default(cuid())
  title        String
  content      String         @db.Text
  order        Int            // Fundamental para el bloqueo lineal (1, 2, 3...)
  
  // --- NUEVOS CAMPOS PARA EL EDITOR INTERACTIVO ---
  sandboxId    String?        // ID del proyecto en StackBlitz (ej: "vitejs-vite-xx")
  showEditor   Boolean        @default(false) // Interruptor para encender el editor
  
  courseId     String
  course       Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userProgress UserProgress[]
  notes        Note[]
  savedLessons SavedLesson[]
  createdAt    DateTime       @default(now())
}

// 4. INSCRIPCIONES: Une al Alumno con el Curso
model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
}

// 5. PROGRESO: El motor de la barra 0-100% y el bloqueo
model UserProgress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  isCompleted Boolean  @default(false)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  updatedAt   DateTime @updatedAt

  @@unique([userId, lessonId])
}

// 6. COMUNIDAD: Estilo Reddit (Preguntas y Respuestas)
model Post {
  id          String    @id @default(cuid())
  title       String
  content     String    @db.Text
  
  // Relaciones
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  courseId    String?   // Opcional, por si la pregunta es general
  course      Course?   @relation(fields: [courseId], references: [id])
  
  resolved    Boolean   @default(false) // Si la duda ya tiene solución
  
  comments    Comment[]
  votes       Vote[]    // Sistema de Karma
  savedPosts  SavedPost[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Vote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  
  type      Int      // 1 para positivo, -1 para negativo
  
  @@unique([userId, postId]) // Un usuario solo puede votar una vez por post
}

model Notification {
  id          String   @id @default(cuid())
  userId      String   // El que recibe la notificación
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title       String
  message     String
  link        String?  // Ej: /comunidad/id-del-post
  read        Boolean  @default(false)
  
  createdAt   DateTime @default(now())
}

model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  isSolution Boolean  @default(false)
  
  parentId  String?
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  
  createdAt DateTime @default(now())
}

model Achievement {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type        String   // EJ: "FIRST_CODE", "TOP_HELPER", "COURSE_COMPLETE"
  title       String
  description String
  icon        String   // Emoji asociado al logro
  
  unlockedAt  DateTime @default(now())

  @@unique([userId, type])
}

// 7. APUNTES: Notas personales de cada usuario por lección
model Note {
  id        String   @id @default(cuid())
  content   String   @db.Text
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([userId, lessonId]) // Solo 1 documento de apuntes por lección y usuario
}

// 8. FAVORITOS: Elementos guardados para después
model SavedPost {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
}

model SavedLesson {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, lessonId])
}